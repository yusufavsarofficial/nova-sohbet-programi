    "helmet": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "morgan": "latest",
    "multer": "^2.0.0",
    "pg": "^8.13.0",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest",
